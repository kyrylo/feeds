#!/bin/sh
set -eu
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$task_root"
case "${1:-}" in
  --help|-h) printf '%s\n' 'Usage: bin/setup [--skip-server]' 'SQLite defaults to storage/feeds.sqlite3; starting the server requires SECRET_KEY_BASE.'; exit 0 ;;
  ''|--skip-server) ;;
  *) printf '%s\n' 'Usage: bin/setup [--skip-server]. Database resets are not supported.' >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then printf '%s\n' 'Too many arguments.' >&2; exit 2; fi
mkdir -p storage
export FEEDS_ENV=${FEEDS_ENV:-${TELESINK_ENV:-development}}
cargo build --manifest-path rust/Cargo.toml --locked --bin feeds
rust/target/debug/feeds db prepare
if [ "${1:-}" != --skip-server ]; then exec bin/dev; fi
