#!/bin/sh
# Always isolated: original Rails is a behavioral oracle, never a native fallback.
set -eu
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$task_root"
export RAILS_ENV=test
export DATABASE_URL=postgresql://telesink@127.0.0.1:55438/telesink_rust_reference
export BUNDLE_PATH="$task_root/tmp/rust-port/bundle"
export SECRET_KEY_BASE=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
export PARALLEL_WORKERS=1
task_ruby=${TELESINK_REFERENCE_RUBY:-ruby}
exec "$task_ruby" bin/rails "$@"
