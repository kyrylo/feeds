#!/usr/bin/env python3
"""Verify a built runtime with disposable data. Usage: bin/test-container IMAGE."""
import html
import http.cookiejar
import json
import re
import secrets
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

image = sys.argv[1] if len(sys.argv) == 2 else "feeds:local"
name = "feeds-check-" + secrets.token_hex(6)
volume = name + "-data"
password = "synthetic-container-password"
replacement = "synthetic-replacement-password"


def docker(*args, data=None):
    return subprocess.check_output(["docker", *args], input=data, text=True).strip()


class Client:
    def __init__(self, base):
        self.base = base
        self.jar = http.cookiejar.CookieJar()
        self.http = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(self.jar))

    def get(self, path):
        with self.http.open(self.base + path, timeout=5) as response:
            return response.read().decode()

    def form(self, path, values):
        values = dict(values)
        values["authenticity_token"] = next(c.value for c in self.jar if c.name == "telesink_csrf")
        with self.http.open(self.base + path, urllib.parse.urlencode(values).encode(), timeout=10) as response:
            return response.read().decode()

    def login(self, value):
        self.get("/session/new")
        return self.form("/session", {"password": value})


def container_url():
    info = json.loads(docker("inspect", name))[0]
    port = info["NetworkSettings"]["Ports"]["3000/tcp"][0]["HostPort"]
    return "http://127.0.0.1:" + port


def ready(base):
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(base + "/ready", timeout=2) as response:
                if response.status == 200:
                    return
        except (OSError, urllib.error.HTTPError):
            time.sleep(.25)
    raise RuntimeError("Runtime did not become ready")


try:
    digest = docker("run", "--rm", "-i", image, "hash-password", data=password)
    assert digest.startswith("$2"), "Password hashing failed"
    docker("volume", "create", volume)
    docker("run", "-d", "--name", name, "--publish", "127.0.0.1::3000",
           "--volume", volume + ":/data", "--env", "SECRET_KEY_BASE=" + secrets.token_hex(64),
           "--env", "FEEDS_PASSWORD_HASH=" + digest,
           "--env", "FEEDS_PUBLIC_URL=https://events.example.test", image)
    info = json.loads(docker("inspect", name))[0]
    assert info["Config"]["User"] not in ("", "0", "root", "0:0"), "Runtime must be non-root"
    base = container_url()
    ready(base)
    docker("exec", name, "/feeds", "healthcheck")
    client = Client(base)
    assert 'id="activity"' in client.login(password), "Owner login failed"
    connection = client.form("/feeds", {"name": "Container check"})
    endpoint = html.unescape(re.search(r'id="feed-url" value="([^"]+)"', connection)[1])
    assert endpoint.startswith("https://events.example.test/api/v1/feeds/"), "Wrong public API origin"
    path = urllib.parse.urlparse(endpoint).path
    body = json.dumps({"text": "Durable container event", "event": "deployed"}).encode()
    for _ in range(2):
        request = urllib.request.Request(base + path, body, {
            "Content-Type": "application/json",
            "Idempotency-Key": "container-retry"})
        with urllib.request.urlopen(request, timeout=5) as response:
            assert response.status == 201
    page = client.get("/")
    assert page.count('data-event-id="') == 1, "A retry duplicated the event"
    docker("exec", name, "/feeds", "db", "backup", "/data/container-backup.sqlite3")
    docker("exec", "--env", "DATABASE_URL=sqlite:///data/container-backup.sqlite3", name, "/feeds", "db", "check")
    docker("restart", name)
    base = container_url()
    client.base = base
    ready(base)
    assert "Durable container event" in client.get("/"), "Restart lost data or the session"
    docker("exec", "-i", name, "/feeds", "reset-password", data=replacement)
    assert 'id="activity"' not in client.get("/"), "Recovery failed to revoke the session"
    assert 'id="activity"' not in Client(base).login(password), "Old password still works"
    assert 'id="activity"' in Client(base).login(replacement), "Replacement password failed"
    docker("restart", name)
    base = container_url()
    client.base = base
    ready(base)
    assert 'id="activity"' in Client(base).login(replacement), "Bootstrap hash replaced the stored credential"
    docker("exec", name, "/feeds", "db", "check")
    print("Container checks passed: non-root startup, owner login, ingestion/retries, backup, restart persistence, password recovery.")
except Exception:
    subprocess.run(["docker", "logs", "--tail", "20", name], check=False)
    raise
finally:
    subprocess.run(["docker", "rm", "--force", "--volumes", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["docker", "volume", "rm", volume], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
