# Feeds reads environment variables, not .env files. Export values in your
# shell, use a service manager, or pass --env-file to Docker.
FEEDS_BIND=127.0.0.1:3000
DATABASE_URL=sqlite://storage/feeds.sqlite3
FEEDS_PUBLIC_URL=http://localhost:3000
# Generate once with openssl rand -hex 64. Keep this value across releases.
# SECRET_KEY_BASE=
# Provision the owner before exposing a fresh installation to the internet.
# Generate with `feeds hash-password`, reading the password from stdin.
# Stored credentials take precedence; this value is ignored after setup.
# FEEDS_PASSWORD_HASH=
# Optional owner contact address, used only at initial provisioning.
# FEEDS_OWNER_EMAIL=you@example.com

# Kamal deployment (local shell only; not part of the app runtime).
# FEEDS_IMAGE=your-github-user/feeds
# FEEDS_SERVER=203.0.113.10
# FEEDS_HOST=events.example.com
# FEEDS_REGISTRY=ghcr.io
# FEEDS_REGISTRY_USERNAME=your-github-user
# FEEDS_ARCH=amd64
# KAMAL_REGISTRY_PASSWORD=

# Optional reset email. Local reset-password works without SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_FROM=Feeds <reset@example.com>
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=starttls
