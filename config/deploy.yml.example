# Copy to config/deploy.yml for a new installation. Existing installations should
# merge these settings, keeping their original data volume and SECRET_KEY_BASE.
service: feeds
image: <%= ENV.fetch("FEEDS_IMAGE").inspect %>
minimum_version: 2.12.0

servers:
  web:
    - <%= ENV.fetch("FEEDS_SERVER").inspect %>

proxy:
  ssl: true
  forward_headers: false
  host: <%= ENV.fetch("FEEDS_HOST").inspect %>
  app_port: 3000
  healthcheck:
    path: /ready
    interval: 3
    timeout: 3

registry:
  server: <%= ENV.fetch("FEEDS_REGISTRY", "ghcr.io").inspect %>
  username: <%= ENV.fetch("FEEDS_REGISTRY_USERNAME").inspect %>
  password:
    - KAMAL_REGISTRY_PASSWORD

builder:
  arch: <%= ENV.fetch("FEEDS_ARCH", "amd64").inspect %>
  dockerfile: Dockerfile

env:
  secret:
    - SECRET_KEY_BASE
    - FEEDS_PASSWORD_HASH
  clear:
    FEEDS_BIND: 0.0.0.0:3000
    DATABASE_URL: sqlite:///data/feeds.sqlite3
    FEEDS_PUBLIC_URL: <%= "https://#{ENV.fetch('FEEDS_HOST')}".inspect %>

volumes:
  - feeds-data:/data

aliases:
  logs: app logs -f
  db_check: app exec --reuse "/feeds db check"

retain_containers: 3
